{
  "name": "saba-games",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/saba-games/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "options": {
        "cwd": "libs/saba-games",
        "args": [
          "--node-env=development",
          "--config=webpack.dev.js"
        ],
        "command": "webpack-cli serve"
      },
      "executor": "nx:run-commands",
      "configurations": {}
    },
    "build": {
      "options": {
        "cwd": "libs/saba-games",
        "args": [
          "--node-env=development",
          "--config=webpack.config.js"
        ],
        "command": "webpack-cli build"
      },
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "webpack-cli"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist\\libs\\saba-games"
      ],
      "executor": "nx:run-commands",
      "configurations": {
        "development": {
          "options": {
            "args": [
              "--node-env=development",
              "--config=webpack.dev.js"
            ]
          }
        },
        "UAT": {
          "options": {
            "args": [
              "--node-env=UAT",
              "--config=webpack.uat.js"
            ]
          }
        },
        "production": {
          "options": {
            "args": [
              "--node-env=production",
              "--config=webpack.config.js"
            ]
          }
        }
      }
    },
    "lint": {
      "cache": true,
      "options": {
        "cwd": "libs/saba-games",
        "command": "eslint ."
      },
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ],
      "executor": "nx:run-commands",
      "configurations": {}
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/saba-games/jest.config.ts"
      }
    }
  },
  "tags": []
}